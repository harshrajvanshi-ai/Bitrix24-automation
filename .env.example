# ==============================================================================
# Bitrix24 Real Estate Local Application - Environment Configuration
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Public HTTPS URL of this application
# Required for Bitrix24 iframes and webhooks (Must be public HTTPS, e.g., ngrok or production domain)
# Example: https://my-estate-crm.ngrok-free.app or https://crm-app.yourdomain.com
PUBLIC_URL=https://my-estate-crm.ngrok-free.app

# Bitrix24 Local Application Credentials
# Obtained when creating a Local Application in Bitrix24:
# Developer resources -> Other -> Local application
CLIENT_ID=app.xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxx
CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin Dashboard Secret
# Protects the /admin field & stage management portal
ADMIN_SECRET=uae_realestate_secret_2026

# OAuth Server
# For Bitrix24 Cloud (default): https://oauth.bitrix.info/oauth/token/
# For On-Premise (Box): Set IS_BOX=true and use portal domain
BITRIX_OAUTH_SERVER=https://oauth.bitrix.info/oauth/token/
IS_BOX=false

# Optional Legacy / Webhook Token fallbacks
BITRIX_OUTBOUND_TOKEN=
outbound_webhook_accesstokken=
