        "defaultValue": "NEW",
        "helpText": "Current sales pipeline stage."
      },
      "description": {
        "label": "Requirements & Special Requests",
        "type": "textarea",
        "required": false,
        "visible": true,
        "helpText": "Specific client notes, preferred towers, floor height, or payment flexibility."
      }
    }
  }
